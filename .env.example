# Copy this file to `.env` in the backend/ directory for local development.
# Real values belong only in your local .env (git-ignored) or in your
# deployment platform's secret manager — never in source control.

# --- General ---
ENVIRONMENT=development

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://workflow:workflow@localhost:5432/workflow_db

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
BACKEND_CORS_ORIGINS=http://localhost:5173
