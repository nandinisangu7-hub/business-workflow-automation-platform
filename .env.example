# Copy this file to `.env` at the project root for Docker Compose,
# or to `backend/.env` for running the backend directly.
# Real values belong only in your local .env (git-ignored) or in your
# deployment platform's secret manager — never in source control.

# --- General ---
ENVIRONMENT=development

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (used by Docker Compose to create the database) ---
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
POSTGRES_DB=workflow_db

# --- Database URL (used by backend when running WITHOUT Docker Compose) ---
# When running via Docker Compose, DATABASE_URL is constructed automatically
# from the POSTGRES_* vars above using the 'db' service name as the host.
DATABASE_URL=postgresql+psycopg2://workflow:workflow@localhost:5432/workflow_db

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# In Docker Compose the frontend is served on port 80.
BACKEND_CORS_ORIGINS=http://localhost:80,http://localhost:5173

# --- External API integration (Phase 8) ---
# Set to false to skip real HTTP calls (useful in CI / offline environments).
HOLIDAY_API_ENABLED=true
# ISO 3166-1 alpha-2 country code used for public holiday checks.
HOLIDAY_COUNTRY_CODE=US
